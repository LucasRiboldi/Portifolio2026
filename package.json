{
  "name": "personal-portal",
  "version": "0.7.4",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup-structure.mjs",
    "sync:skills": "node scripts/sync-skills.mjs",
    "sync:vercel-env": "node scripts/sync-vercel-env.mjs",
    "tokens:export": "node --experimental-strip-types --no-warnings scripts/export-tokens.mjs",
    "tokens:check": "node --experimental-strip-types --no-warnings scripts/check-tokens.mjs",
    "db:seed": "tsx --tsconfig tsconfig.scripts.json scripts/firestore-seed.ts",
    "db:sync": "tsx --tsconfig tsconfig.scripts.json scripts/firestore-seed.ts --sync",
    "covers": "node scripts/generate-covers.mjs",
    "covers:check": "node scripts/generate-covers.mjs --check",
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "test:integration": "firebase emulators:exec --only firestore --project portifolio-testes \"vitest run --config vitest.integration.config.ts\"",
    "assets:anfitriao": "node scripts/optimize-anfitriao-assets.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@gsap/react": "^2.1.2",
    "@react-three/fiber": "^9.6.1",
    "@types/three": "^0.185.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.17.0",
    "motion": "^12.43.0",
    "next": "^15.5.19",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.11.0",
    "sugar-high": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "jwks-rsa": {
      "jose": "^5.10.0"
    },
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@storybook/addon-a11y": "^10.5.0",
    "@storybook/addon-docs": "^10.5.0",
    "@storybook/addon-mcp": "^0.1.3",
    "@storybook/addon-vitest": "^10.5.0",
    "@storybook/nextjs-vite": "^10.5.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10",
    "eslint": "^9",
    "eslint-config-next": "15.2.0",
    "eslint-plugin-storybook": "^10.5.0",
    "playwright": "^1.61.1",
    "postcss": "^8.5.10",
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.5.0",
    "tailwindcss": "^3",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
