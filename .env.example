# ─── Firebase (client) ───────────────────────────────────────
# Console → Project settings → General → Your apps → SDK setup.
# Só o Auth roda no browser; nenhum dado é lido daqui.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase (server / Admin SDK) ───────────────────────────
# Console → Project settings → Service accounts → Generate new private key.
# Todo acesso a Firestore e Storage passa por aqui. SEGREDO — só server.
#
# Em desenvolvimento você pode, em vez destas duas, deixar o arquivo
# `serviceAccountKey.json` na raiz do projeto (está no .gitignore).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# A chave inteira em uma linha, com os \n escapados, entre aspas.
FIREBASE_PRIVATE_KEY=

# ─── Admin ───────────────────────────────────────────────────
# Login do GitHub autorizado a acessar /admin (allowlist de 1).
# Sem correspondência, o login não gera sessão nenhuma.
ADMIN_GITHUB_LOGIN=LucasRiboldi

# Opcional: eleva o rate limit da consulta que traduz o id numérico do
# GitHub para o username, feita uma vez por login.
GITHUB_TOKEN=

# ─── Prophet Wire (agregador de notícias) ────────────────────
# Segredo do gatilho diário em /api/prophet-wire/run.
# A Vercel Cron envia este valor como `Authorization: Bearer <valor>`.
# Sem ele configurado o endpoint recusa TUDO (falha fechada).
# Gere um valor aleatório longo, ex.: openssl rand -hex 32
CRON_SECRET=
