# ─── Supabase ────────────────────────────────────────────────
# Projeto: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — SOMENTE server. Nunca expor no client.
SUPABASE_SERVICE_ROLE_KEY=
# Connection string do Postgres, usada só por `npm run db:migrate`.
# Project Settings → Database → Connection string → URI. Não é a service role:
# DDL precisa de conexão Postgres direta. Nunca vai para o client nem para o git.
SUPABASE_DB_URL=

# ─── Admin ───────────────────────────────────────────────────
# Login do GitHub autorizado a acessar /admin (allowlist de 1).
ADMIN_GITHUB_LOGIN=LucasRiboldi

# ─── Prophet Wire (agregador de notícias) ────────────────────
# Segredo do gatilho diário em /api/prophet-wire/run.
# A Vercel Cron envia este valor como `Authorization: Bearer <valor>`.
# Sem ele configurado o endpoint recusa TUDO (falha fechada).
# Gere um valor aleatório longo, ex.: openssl rand -hex 32
CRON_SECRET=
