rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// STORAGE — regras de acesso
//
// Conversão das quatro policies do bucket `public-media`:
//   public_media_read          → leitura aberta (as imagens aparecem no site)
//   public_media_admin_insert  → escrita
//   public_media_admin_update  → escrita
//   public_media_admin_delete  → escrita
//
// As três de escrita viram uma negação: no arranjo anterior elas enxergavam
// "usuário autenticado", mas não conheciam a allowlist de admin do app — então
// qualquer conta logada podia enviar ou apagar arquivo. O código já havia
// fechado esse buraco levando o upload para uma Server Action com
// `requireAdmin()` + validação por magic bytes (ver `app/admin/media/actions.ts`,
// que registra o problema). Aqui a porta do cliente fica trancada de vez.
//
// O Firebase Storage tem um bucket por projeto, e não buckets nomeados como o
// Supabase: o antigo bucket virou o prefixo `public-media/`.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    // Mídia do painel: leitura pública, escrita só pelo servidor.
    match /public-media/{arquivo} {
      allow read: if true;
      allow write: if false;
    }

    // Nenhum outro caminho é acessível.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
